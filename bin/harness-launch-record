#!/usr/bin/env python3
"""Launcher-owned launch record: the only source of a restored grant.

  harness-launch-record claude [--source-root R] [--isolated 0|1] [--permission P]
                               [--harness-session-id U] [--context 1m]
                               [--task-id U] [--parent-native U] [--callback]
  harness-launch-record codex [--callback]        (settings from the environment)
  harness-launch-record read <claude|codex> <id>  print the validated record

As a SessionStart hook this command reads the payload on stdin and writes
<state>/launch-records/<agent>-<session_id> (0600, key=value). It never reads a
transcript or rollout, and prints nothing (a hook's stdout becomes session
context). It always exits 0.

Auto-link facts (P3-L): the record also holds the SessionStart `source`, the
`agent_pid` and `agent_start` (ps lstart in UTC, whitespace-collapsed) of the agent
process found by the ancestry walk, and the launcher's `task_id` (--task) and
`parent_native` (fork; kept for the first record of the agent process only). With --callback the same command then runs the optional
host collector callback (`~/.local/share/harness-service/bin/harness-session-hook
--runtime <agent>`) with the same payload, strictly after the record is durable:
record and callback are one sequential command, no cross-hook ordering is
assumed. The callback gets what is left of the hook budget, its output is
discarded and its failure never changes the exit status.

Where the grant comes from:
  claude  arguments of the hook command inside the launcher's own --settings
          JSON. The environment is ignored: Claude applies the `env` block of
          .claude/settings.local.json, which an agent can write.
  codex   the launcher's HARNESS_LAUNCH_* environment (APPROVAL, SANDBOX,
          BYPASS, PROFILE, SOURCE_ROOT, ISOLATED), because the hooks.json
          row is static.

A nested launch (one that runs inside an agent) may keep or lower an existing
record's grant but never raise it, and creates a record without a grant when
none exists. A top-level launch replaces the record. Nesting is decided here,
from process ancestry, never from the environment: from the agent process that
ran this hook, any further ancestor whose executable basename is exactly
`claude` or `codex` makes the launch nested (at most 64 hops). A process table
that cannot be read counts as nested (it can only withhold a grant).
`--pstable FILE --start-pid N` replace the live process table in tests.
"""
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import time
import uuid

UUID = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
SOURCES = {"startup", "resume", "clear", "compact", "fork"}
AGENTS = {"claude", "codex"}
MAX_RECORD = 64 * 1024
# Lowest privilege first; a nested launch may only move a field toward the front.
RANKS = {
    # dontAsk denies every tool that is not pre-approved, so it is barely above plan.
    "permission": ["plan", "dontAsk", "default", "acceptEdits", "auto", "bypassPermissions"],
    "approval": ["untrusted", "on-failure", "on-request", "never"],
    "sandbox": ["read-only", "workspace-write", "danger-full-access"],
    "network": ["disabled", "enabled"],
}
PROFILES = {"fast", "base", "sol", "astra", "plan", "rich"}
GRANT_KEYS = ("permission", "approval", "sandbox", "network", "bypass", "profile")
CHECKS = {
    "permission": lambda v: v in RANKS["permission"],
    "approval": lambda v: v in RANKS["approval"],
    "sandbox": lambda v: v in RANKS["sandbox"],
    "network": lambda v: v in RANKS["network"],
    "bypass": lambda v: v == "1",
    "profile": lambda v: v in PROFILES,
    "source_root": lambda v: v.startswith("/") and not re.search(r"[\x00-\x1f\x7f]", v),
    "isolated": lambda v: v in {"0", "1"},
    "harness_session_id": lambda v: UUID.fullmatch(v) is not None,
    # Not a grant (it only sizes the context window), so no rank rules apply.
    "context": lambda v: v == "1m",
    # Auto-link facts; none of them is a grant.
    "source": lambda v: v in SOURCES,
    "agent_pid": lambda v: v.isascii() and v.isdigit() and 0 < int(v) < 2 ** 31,
    "agent_start": lambda v: AGENT_START.fullmatch(v) is not None,
    "task_id": lambda v: UUID.fullmatch(v) is not None,
    "parent_native": lambda v: UUID.fullmatch(v) is not None,
}
ORDER = ("permission", "approval", "sandbox", "network", "bypass", "profile",
         "source_root", "isolated", "harness_session_id", "context",
         "source", "agent_pid", "agent_start", "task_id", "parent_native")
# Facts about this one SessionStart event: a nested launch takes them from the
# new event, never from an older record.
EVENT_KEYS = ("source", "agent_pid", "agent_start", "task_id", "parent_native")
ENV_KEYS = {
    "approval": "HARNESS_LAUNCH_APPROVAL", "sandbox": "HARNESS_LAUNCH_SANDBOX",
    "network": "HARNESS_LAUNCH_NETWORK",
    "bypass": "HARNESS_LAUNCH_BYPASS", "profile": "HARNESS_LAUNCH_PROFILE",
    "source_root": "HARNESS_LAUNCH_SOURCE_ROOT", "isolated": "HARNESS_LAUNCH_ISOLATED",
    "harness_session_id": "HARNESS_SESSION_ID",
    "task_id": "HARNESS_LAUNCH_TASK_ID", "parent_native": "HARNESS_LAUNCH_PARENT_NATIVE",
}
CLAUDE_FLAGS = {
    "--permission": "permission", "--source-root": "source_root",
    "--isolated": "isolated", "--harness-session-id": "harness_session_id",
    "--context": "context", "--task-id": "task_id", "--parent-native": "parent_native",
}
AGENT_NAMES = {"claude", "codex"}
MAX_HOPS = 64
# `ps lstart`: "Tue Oct  6 09:05:07 2026" (day space-padded); stored with single spaces.
LSTART = r"[A-Z][a-z]{2}\s+[A-Z][a-z]{2}\s+\d{1,2}\s+\d\d:\d\d:\d\d\s+\d{4}"
AGENT_START = re.compile(r"[A-Z][a-z]{2} [A-Z][a-z]{2} \d{1,2} \d\d:\d\d:\d\d \d{4}")
PS_LINE = re.compile(r"\s*(\d+)\s+(\d+)\s+(?:(%s)\s+)?(\S.*)" % LSTART)
HOOK_RELATIVE = ".local/share/harness-service/bin/harness-session-hook"
# Seconds from this command's start after which the callback is cut off: the
# combined SessionStart hook timeout is 10, one second stays as margin.
CALLBACK_DEADLINE = 9.0


def state_home():
    explicit = os.environ.get("HARNESS_SESSION_STATE_HOME")
    if explicit:
        return explicit
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "harness-launcher")


def record_name(agent, session_id):
    if agent not in AGENTS or not UUID.fullmatch(session_id):
        return None
    return "%s-%s" % (agent, session_id.lower())


def open_records_dir(create):
    """O_DIRECTORY|O_NOFOLLOW descriptor of <state>/launch-records, or None."""
    path = os.path.join(state_home(), "launch-records")
    if create:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        try:
            os.mkdir(path, 0o700)
        except FileExistsError:
            pass
    try:
        return os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        return None


def read_fields(dir_fd, name):
    """Validated fields of one record: regular, ours, single link, no symlink."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
    except OSError:
        return None
    try:
        meta = os.fstat(fd)
        if not stat.S_ISREG(meta.st_mode) or meta.st_uid != os.getuid() or meta.st_nlink != 1:
            return None
        data = os.read(fd, MAX_RECORD)
    finally:
        os.close(fd)
    found = {}
    for raw in data.decode("utf-8", "replace").split("\n"):
        key, sep, value = raw.partition("=")
        if sep and key in CHECKS and CHECKS[key](value):
            found[key] = value
    return found


def rank_lower(key, new, old):
    order = RANKS[key]
    return order.index(new) < order.index(old)


def merge_nested(existing, new):
    """A nested launch may keep or lower an existing grant, never raise it."""
    if existing is None:
        return {k: v for k, v in new.items() if k not in GRANT_KEYS}
    merged = dict(existing)
    for key in RANKS:
        if key in new and key in existing and rank_lower(key, new[key], existing[key]):
            merged[key] = new[key]
    for key in EVENT_KEYS:
        merged.pop(key, None)
        if key in new:
            merged[key] = new[key]
    return merged


def ancestry_nested(table, start_pid, max_hops=MAX_HOPS):
    """True when a second agent process sits above the one that ran the hook.

    table maps pid -> (ppid, command[, start]). Walking up from start_pid, the
    first executable whose basename is exactly claude or codex is the agent that
    ran the hook; any further one above it makes this launch nested. Stops at
    pid 1, an unknown pid, or max_hops.
    """
    return walk_agents(table, start_pid, max_hops)[1]


def agent_process(table, start_pid):
    """(pid, start) of the agent that ran the hook, or (None, None)."""
    pid = walk_agents(table, start_pid)[0]
    entry = table.get(pid) if pid else None
    if entry is None or len(entry) < 3 or entry[2] is None:
        return None, None
    return pid, entry[2]


def walk_agents(table, start_pid, max_hops=MAX_HOPS):
    """(pid of the first agent ancestor or None, nested)."""
    pid, owner = start_pid, None
    for _ in range(max_hops):
        if pid <= 1 or pid not in table:
            return owner, False
        ppid, command = table[pid][:2]
        if os.path.basename(command) in AGENT_NAMES:
            if owner is not None:
                return owner, True
            owner = pid
        pid = ppid
    return owner, False


def process_table(path=None):
    """pid -> (ppid, command, start) from a fixture file or the live `ps`; None if unreadable.

    start is the whitespace-collapsed lstart, None for a fixture line without one.
    """
    try:
        if path:
            with open(path, encoding="utf-8") as stream:
                text = stream.read()
        else:
            text = subprocess.run(["ps", "-axo", "pid=,ppid=,lstart=,comm="], capture_output=True,
                                  text=True, timeout=5, check=True,
                                  env=dict(os.environ, LC_ALL="C", TZ="UTC0")).stdout
        table = {}
        for line in text.splitlines():
            match = PS_LINE.fullmatch(line)
            if match:
                start = " ".join(match.group(3).split()) if match.group(3) else None
                table[int(match.group(1))] = (int(match.group(2)), match.group(4).strip(), start)
        return table
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def launch_nested(pstable, start_pid):
    table = process_table(pstable)
    if table is None:
        return True
    return ancestry_nested(table, start_pid)


def launch_settings(agent):
    """(fields, pstable, start_pid) for this launch: arguments (claude) or environment (codex)."""
    raw, pstable, start_pid = {}, None, os.getpid()
    args = [a for a in sys.argv[2:] if a != "--callback"]
    if len(args) % 2:
        return None, None, start_pid
    for flag, value in zip(args[0::2], args[1::2]):
        if flag == "--pstable":
            pstable = value
        elif flag == "--start-pid" and value.isdigit():
            start_pid = int(value)
        elif agent == "claude" and flag in CLAUDE_FLAGS:
            raw[CLAUDE_FLAGS[flag]] = value
        else:
            return None, None, start_pid
    if agent == "codex":
        raw = {key: os.environ.get(var, "") for key, var in ENV_KEYS.items()}
    fields = {k: v for k, v in raw.items() if v and CHECKS[k](v)}
    return fields, pstable, start_pid


def claim_parent(dir_fd, fields):
    """True only for the first record of this agent process.

    --parent-native is a fixed hook argument, so every later SessionStart of the
    same process (/branch, /clear, compaction, resume) would repeat it under its
    new session id. The parent is meaningful for the process's first session
    only: an O_EXCL marker keyed by pid and start time grants it once. Without a
    process identity there is no key, and no parent beats a wrong one.
    """
    if "agent_pid" not in fields:
        return False
    key = hashlib.sha256(("%s:%s" % (fields["agent_pid"], fields["agent_start"])).encode()).hexdigest()[:32]
    try:
        os.close(os.open(".parent-" + key, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dir_fd))
    except OSError:
        return False
    return True


def write(agent, raw=None):
    payload = json.loads(sys.stdin.read() if raw is None else raw)
    if not isinstance(payload, dict) or payload.get("hook_event_name") != "SessionStart":
        return
    session_id = payload.get("session_id")
    if payload.get("source") not in SOURCES or not isinstance(session_id, str):
        return
    name = record_name(agent, session_id)
    if name is None:
        return
    fields, pstable, start_pid = launch_settings(agent)
    if fields is None or "source_root" not in fields or "isolated" not in fields:
        return
    fields["source"] = payload["source"]
    if fields.get("parent_native", "").lower() == session_id.lower():
        del fields["parent_native"]  # a session is never its own parent; this does not use the claim
    dir_fd = open_records_dir(create=True)
    if dir_fd is None:
        return
    try:
        table = process_table(pstable)
        if table is not None:
            pid, start = agent_process(table, start_pid)
            if pid is not None:
                fields["agent_pid"], fields["agent_start"] = str(pid), start
        if "parent_native" in fields and not claim_parent(dir_fd, fields):
            del fields["parent_native"]
        # An unreadable process table counts as nested: it can only withhold a grant.
        if table is None or ancestry_nested(table, start_pid):
            fields = merge_nested(read_fields(dir_fd, name), fields)
        text = "".join("%s=%s\n" % (k, fields[k]) for k in ORDER if k in fields)
        temp = ".tmp-%s" % uuid.uuid4().hex
        fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dir_fd)
        try:
            try:
                os.write(fd, text.encode("utf-8"))
                os.fsync(fd)
            finally:
                os.close(fd)
            os.replace(temp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
            os.fsync(dir_fd)
        except BaseException:
            try:
                os.unlink(temp, dir_fd=dir_fd)
            except OSError:
                pass
            raise
    finally:
        os.close(dir_fd)


def read(agent, session_id):
    name = record_name(agent, session_id)
    dir_fd = open_records_dir(create=False) if name else None
    if dir_fd is None:
        return []
    try:
        found = read_fields(dir_fd, name)
    finally:
        os.close(dir_fd)
    if not found:
        return []
    return ["%s=%s" % (key, found[key]) for key in ORDER if key in found]


def run_callback(agent, raw, started):
    """Run the optional host collector callback with this hook's payload.

    Output is discarded and nothing here can fail the hook. The callback gets
    what is left of CALLBACK_DEADLINE (at least half a second).
    """
    script = os.path.join(os.path.expanduser("~"), HOOK_RELATIVE)
    if not (os.path.isfile(script) and os.access(script, os.X_OK)):
        return
    remaining = max(0.5, CALLBACK_DEADLINE - (time.monotonic() - started))
    try:
        subprocess.run(["/bin/sh", script, "--runtime", agent], input=raw.encode("utf-8"),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=remaining, check=False)
    except (OSError, ValueError, subprocess.SubprocessError):
        pass


def hook(agent):
    started = time.monotonic()
    raw = sys.stdin.read()
    try:
        write(agent, raw)
    except Exception:
        pass
    if "--callback" in sys.argv[2:]:
        run_callback(agent, raw, started)


def main(argv):
    if len(argv) == 4 and argv[1] == "read":
        lines = read(argv[2], argv[3])
        if lines:
            sys.stdout.write("\n".join(lines) + "\n")
    elif len(argv) >= 2 and argv[1] in AGENTS:
        hook(argv[1])


if __name__ == "__main__":
    try:
        main(sys.argv)
    except BaseException:
        pass
    sys.exit(0)
